//this is how you declare variables

package main

import "fmt"

func main(){
	//short declaration
	message:= "hello, world" //type inferred as string
	age:= 26	//type inferred as int
	score:= 94.5    //type inferred as float64

	//with the keyword var
	//with the type and no initial value
	var count int //initialized to 0
	//with a type and initial value
	var name string= "GuateGolang"
	//type inference(Ommitting the type)
	var numberOfDay=19
	fmt.Println(count, name, message,age,score,numberOfDay)
}

	
